# ---------------------------------------------------------------------------
# Interactive Poster Studio — GitLab/GitHub-ready ignore list
#
# The app itself is 100% static source: index.html, css/, js/ and assets/ are all
# meant to be committed. Everything below is either machine-local, generated by a
# tool, or a poster export that belongs to one person's working session.
# ---------------------------------------------------------------------------

# --- Dependencies (only ever created by `npx serve`) ---
node_modules/
.npm/
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Build & cache directories ---
dist/
build/
out/
.cache/
.parcel-cache/
.tmp/
tmp/

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*
logs/

# --- User poster exports -------------------------------------------------
# Exports land in your Downloads folder by default, but people often drop them
# back into the project. Keep working copies out of version control; commit a
# poster deliberately by force-adding it:  git add -f my_poster.json
exports/
*.pdf
*_Copy.json
*_Copy_*.json
*.local.json
*.local.md

# Do NOT ignore the placeholder artwork the default template depends on
!assets/placeholders/*.svg

# --- Secrets / environment ---
.env
.env.*
!.env.example
